#!/usr/bin/env bash
# liveapp-hook-version: 1
#
# liveapp-pre-push.sh — the Live App Contract's GIT-NATIVE push gate, installed into the app's
# effective git hooks dir by the `agent_hooks` bootstrap (chained in front of any existing hook).
#
# WHY THIS LAYER EXISTS (guard v1→v4 post-mortem): a PreToolUse string matcher must re-parse
# shell AND git argv — four review rounds found bypass after bypass (compound commands, ssh/https
# remotes, HEAD/@, +force, refs/heads/, message words). `pre-push` gets the ANSWER instead of the
# question: git hands us the exact resolved refs on stdin. There is nothing left to parse.
#
# Git contract: argv = <remote name> <remote url>; stdin lines =
#   <local ref> <local sha> <remote ref> <remote sha>
# We DENY (exit 1) when any <remote ref> is the default branch (or master, default-class) —
# including a delete — unless an approval is present:
#   * TOKEN  — $(git rev-parse --git-common-dir)/liveapp-approve, minted by the PreToolUse guard
#              when the SESSION's last user message carries the approval phrase ("ship it", …).
#              Short-TTL (LIVEAPP_APPROVE_TTL, default 600s) and ONE-SHOT (consumed on read).
#   * TTY    — a human in a plain terminal gets a y/N prompt on /dev/tty. Never under the loop
#              (LIVEAPP_LOOP) or a Claude session (CLAUDECODE) — headless is a hard deny.
# A pre-existing app hook is preserved as <this>.liveapp-chained and exec'd with the SAME argv +
# stdin after our gate allows — the app's own validation still runs.
#
# LIVEAPP_* read here (env > default; test/emergency hooks documented):
#   LIVEAPP_DEFAULT_BRANCH  the default branch (else origin/HEAD, else main; master always gated)
#   LIVEAPP_APPROVE_TTL     token freshness window in seconds (default 600)
#   LIVEAPP_HOOK_CONFIRM    the tty answer for TEST HARNESSES (y/n). IGNORED under LIVEAPP_LOOP —
#                           the loop can never script its way through.
#   LIVEAPP_LOOP            set by the engine's cycle runner: never prompt, never confirm.
#   LIVEAPP_CHAINED_HOOK    test override for the chained hook path (default: $0.liveapp-chained)
set -uo pipefail

DEF="${LIVEAPP_DEFAULT_BRANCH:-$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')}"
DEF="${DEF:-main}"
is_default() { [ "$1" = "$DEF" ] || [ "$1" = master ]; }

deny() {
  {
    echo "liveapp pre-push: refusing push to the default branch '$DEF'."
    echo "  To approve: say the approval phrase in your Claude session ('ship it' / 'push'),"
    echo "  or answer y at this prompt in an interactive terminal. The autonomous loop is"
    echo "  never approved — its merges go through a PR and the human."
  } >&2
  exit 1
}

token_ok() {
  local gd t ts now
  gd="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
  [ -n "$gd" ] || return 1
  t="$gd/liveapp-approve"
  [ -f "$t" ] || return 1
  ts="$(cat "$t" 2>/dev/null)"; now="$(date +%s)"
  rm -f "$t"                                  # ONE-SHOT either way — stale tokens never linger
  case "$ts" in ''|*[!0-9]*) return 1;; esac
  [ $(( now - ts )) -le "${LIVEAPP_APPROVE_TTL:-600}" ]
}

tty_ok() {
  [ -n "${LIVEAPP_LOOP:-}" ] && return 1                      # the loop NEVER confirms
  if [ -n "${LIVEAPP_HOOK_CONFIRM:-}" ]; then                 # test-harness tty answer
    [ "$LIVEAPP_HOOK_CONFIRM" = y ]; return $?
  fi
  [ -n "${CLAUDECODE:-}" ] && return 1                        # Claude sessions use the token path
  [ -t 2 ] || return 1                                        # no interactive terminal -> no prompt
  [ -e /dev/tty ] || return 1
  printf "liveapp: this push targets the default branch '%s' — proceed? [y/N] " "$DEF" > /dev/tty 2>/dev/null || return 1
  local ans=""
  read -r -t 30 ans < /dev/tty 2>/dev/null || return 1
  [ "$ans" = y ] || [ "$ans" = Y ]
}

REFS="$(cat)"
gated=0
while read -r _lref _lsha rref _rsha; do
  [ -n "${rref:-}" ] || continue
  case "$rref" in
    refs/heads/*) is_default "${rref#refs/heads/}" && gated=1 ;;
  esac
done <<EOF
$REFS
EOF

if [ "$gated" = 1 ]; then
  token_ok || tty_ok || deny
fi

# chain the app's own pre-push (preserved at install time) with the SAME argv + stdin
CHAINED="${LIVEAPP_CHAINED_HOOK:-$0.liveapp-chained}"
if [ -x "$CHAINED" ]; then
  printf '%s\n' "$REFS" | "$CHAINED" "$@" || exit $?
fi
exit 0
